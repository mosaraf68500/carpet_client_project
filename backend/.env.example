# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doha-furniture

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Seeded admin (used only by `npm run seed:admin`)
ADMIN_EMAIL=admin@dohafurniture.qa
ADMIN_PASSWORD=change-this-before-seeding

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (for quote/contact form notification emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Doha Furniture <no-reply@dohafurniture.qa>"
NOTIFY_EMAIL=owner@dohafurniture.qa
