# Production environment variables — set these in the hosting dashboard
# (e.g. Vercel Project Settings → Environment Variables), not in a committed
# .env file. This file documents what's required; every value below is a
# placeholder, not a real secret.

# --- Server ---
PORT=8000
NODE_ENV=production

# Real frontend/dashboard domains (no trailing slash). These two are kept
# for backward compatibility; prefer ALLOWED_ORIGINS for multiple domains.
CLIENT_URL=https://www.dohacarpet.qa
DASHBOARD_URL=https://dashboard.dohacarpet.qa
# Comma-separated list of every other allowed origin (www/non-www, staging, etc).
# NODE_ENV=production disables the automatic localhost allowance, so every
# origin the frontend/dashboard is served from must be listed here or above.
ALLOWED_ORIGINS=

# --- MongoDB Atlas ---
# Use a production cluster/database — not the same one used for local dev.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doha-carpet

# --- JWT ---
# Required — the server refuses to start without this. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Seeded admin (used only by `npm run seed:admin`, run once against prod) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SMTP (quote/contact form notification emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Doha Carpet <no-reply@dohacarpet.qa>"
NOTIFY_EMAIL=
