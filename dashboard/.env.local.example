NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Direct browser-to-Cloudinary upload (bypasses the backend, avoids the
# Vercel serverless function timeout on image uploads). Cloud name matches
# backend/.env's CLOUDINARY_CLOUD_NAME. Upload preset must be created in
# Cloudinary dashboard -> Settings -> Upload -> Add upload preset, with
# Signing Mode: Unsigned.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dicz0wggq
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=doha_carpet_unsigned
